{
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "EasyOffset",
    "id": "easyoffset",
    "version": "2.2.0",
    "url": "https://github.com/trail-b1az3r/EasyOffset-quest",
    "additionalData": {
      "overrideSoName": "libeasyoffset.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "sh ./scripts/build.sh"
      ],
      "qmod": [
        "sh ./scripts/build.sh",
        "qpm qmod manifest",
        "qpm qmod zip --skip_build"
      ]
    },
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./EasyOffset.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4008.0.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.1.26",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": ">=4.6.4, <4.7.0",
      "additionalData": {}
    },
    {
      "id": "rapidjson-macros",
      "versionRange": "^2.1.0",
      "additionalData": {}
    }
  ]
}
